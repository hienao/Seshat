# BaseGoApp 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ===== 数据库配置 =====

# 默认使用 SQLite，数据库文件保存在容器挂载目录 /data/db 下
DB_DRIVER=sqlite
SQLITE_PATH=/data/db/basegoapp.db

# 挂载目录约定
DATA_DIR=/data
CACHE_DIR=/cache
LOG_DIR=/cache/logs/app

# PostgreSQL 模式下必填：
# DB_DRIVER=postgres
# DATABASE_URL=postgres://postgres:postgres@db:5432/basegoapp?sslmode=disable
DATABASE_URL=

# ===== 必填配置 =====

# JWT 签名密钥（生产环境请使用至少 32 位的强随机字符串）
JWT_SECRET=your-secret-key-change-in-production

# ===== 可选配置 =====

# Gin 运行模式 (debug/release)
GIN_MODE=release

# 后端 API 端口
SERVER_PORT=8080

# ===== PostgreSQL 配置（仅 docker-compose 使用）=====

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basegoapp
