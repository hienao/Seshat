# BaseGoApp 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ===== 必填配置 =====

# PostgreSQL 数据库连接串
# 格式: postgres://用户名:密码@主机:端口/数据库名?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@db:5432/basegoapp?sslmode=disable

# JWT 签名密钥（生产环境请使用至少 32 位的强随机字符串）
JWT_SECRET=your-secret-key-change-in-production

# ===== 可选配置 =====

# Gin 运行模式 (debug/release)
GIN_MODE=release

# 后端 API 端口
SERVER_PORT=8080

# ===== PostgreSQL 配置（仅 docker-compose 使用）=====

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basegoapp
