# Seshat 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ===== 数据库配置 =====

# 默认使用 SQLite，数据库文件路径固定为 /data/db/seshat.db
DB_DRIVER=sqlite

# 挂载目录约定（容器内路径固定为 /data 和 /cache）
HOST_DATA_DIR=./runtime/data
HOST_CACHE_DIR=./runtime/cache

# PostgreSQL 模式下必填：
# DB_DRIVER=postgres
# DATABASE_URL=postgres://postgres:postgres@db:5432/seshat?sslmode=disable
DATABASE_URL=

# ===== 必填配置 =====

# JWT 签名密钥（生产环境请使用至少 32 位的强随机字符串）
JWT_SECRET=your-secret-key-change-in-production

# 容器日志和应用本地时间（IANA 时区名）
TZ=UTC

# 静态版本更新源（可替换为绑定到 Cloudflare Pages 的自定义域名）
SESHAT_UPDATE_FEED_BASE_URL=https://seshatapp.pages.dev/updates/v1

# ===== PostgreSQL 配置（仅 docker-compose 使用）=====

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seshat
