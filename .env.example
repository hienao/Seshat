# BaseGoApp 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ===== 数据库配置 =====

# 默认使用 SQLite，数据库文件路径固定为 /data/db/basegoapp.db
DB_DRIVER=sqlite

# 挂载目录约定（容器内路径固定为 /data 和 /cache）
HOST_DATA_DIR=./runtime/data
HOST_CACHE_DIR=./runtime/cache

# PostgreSQL 模式下必填：
# DB_DRIVER=postgres
# DATABASE_URL=postgres://postgres:postgres@db:5432/basegoapp?sslmode=disable
DATABASE_URL=

# ===== 必填配置 =====

# JWT 签名密钥（生产环境请使用至少 32 位的强随机字符串）
JWT_SECRET=your-secret-key-change-in-production

# CORS 白名单（多个用逗号分隔，需包含协议）
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# 认证 Cookie 配置
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false

# 首次启动管理员初始化（仅当数据库无用户时使用）
# 注意：密码至少 12 位，禁止 admin/admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123456

# ===== 可选配置 =====

# Gin 运行模式 (debug/release)
GIN_MODE=release


# ===== PostgreSQL 配置（仅 docker-compose 使用）=====

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basegoapp
